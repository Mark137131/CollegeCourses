  28          * 函数功能       : 外部中断0服务函数，接受遥控器传入的数据
  29          * 输    入       : 无
  30          * 输    出       : 无
  31          *******************************************************************************/
  32          
  33          void ired() interrupt 0 //外部中断0服务函数
  34          {
  35   1        u8 ired_high_time=0;
  36   1        u16 time_cnt=0;
  37   1        u8 i=0,j=0;
  38   1      
  39   1        if(IRED==0)
  40   1        {
  41   2          time_cnt=1000;
  42   2          while((!IRED)&&(time_cnt))//等待引导信号9ms低电平结束，若超过10ms强制退出
  43   2          {
  44   3            delay_10us(1);//延时约10us
  45   3            time_cnt--;
  46   3            if(time_cnt==0)return;    
  47   3          }
  48   2          if(IRED)//引导信号9ms低电平已过，进入4.5ms高电平
  49   2          {
  50   3            time_cnt=500;
  51   3            while(IRED&&time_cnt)//等待引导信号4.5ms高电平结束，若超过5ms强制退出
  52   3            {
  53   4              delay_10us(1);
  54   4              time_cnt--;
C51 COMPILER V9.57.0.0   IRED                                                              12/24/2024 20:33:30 PAGE 2   

  55   4              if(time_cnt==0)return;  
  56   4            }
  57   3            for(i=0;i<4;i++)//循环4次，读取4个字节数据
  58   3            {
  59   4              for(j=0;j<8;j++)//循环8次读取每位数据即一个字节
  60   4              {
  61   5                time_cnt=600;
  62   5                while((IRED==0)&&time_cnt)//等待数据1或0前面的0.56ms结束，若超过6ms强制退出
  63   5                {
  64   6                  delay_10us(1);
  65   6                  time_cnt--;
  66   6                  if(time_cnt==0)return;  
  67   6                }
  68   5                time_cnt=20;
  69   5                while(IRED)//等待数据1或0后面的高电平结束，若超过2ms强制退出
  70   5                {
  71   6                  delay_10us(10);//约0.1ms
  72   6                  ired_high_time++;
  73   6                  if(ired_high_time>20)return;  
  74   6                }
  75   5                gired_data[i]>>=1;//先读取的为低位，然后是高位
  76   5                if(ired_high_time>=8)//如果高电平时间大于0.8ms，数据则为1，否则为0
  77   5                  gired_data[i]|=0x80;
  78   5                ired_high_time=0;//重新清零，等待下一次计算时间
  79   5              }
  80   4            }
  81   3          }
  82   2          if(gired_data[2]!=~gired_data[3])//校验控制码与反码，错误则返回
  83   2          {
  84   3            for(i=0;i<4;i++)
  85   3              gired_data[i]=0;
  86   3            return; 
  87   3          }
  88   2        }   
  89   1      }
