  97          
  98          u8 iredKey()
  99          { 
 100   1        u8 i=0,j=0;
 101   1        for (i = 0; i < 3; i++) 
 102   1        {
 103   2          for (j = 0; j < 3; j++) 
 104   2          {
 105   3            if (gired_data[2] == ir_code[i][j]) 
 106   3            {
 107   4              gired_data[2] = 0x00;
 108   4              return 3*i+j+9;
 109   4            }
 110   3          }
 111   2        }
 112   1        return 0;
