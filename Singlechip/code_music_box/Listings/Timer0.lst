   1          #include "reg52.h"
   2          #include "public.h" 
   3          
   4          /*******************************************************************************
   5          * 函 数 名      : Timer0Init
   6          * 函数功能       : 定时器0初始化，1毫秒@12.000MHz
   7          * 输    入       : 无
   8          * 输    出       : 无
   9          *******************************************************************************/
  10          
  11          void Timer0Init(void)   
  12          {
  13   1        TMOD &= 0xF0;   //设置定时器模式（把TMOD低四位清零，高四位保持不变）
  14   1        TMOD |= 0x01;   //设置定时器模式（把TMOD最低位置1，高四位保持不变）
  15   1        TL0 = 0x18;   //设置定时初值
  16   1        TH0 = 0xFC;   //设置定时初值
  17   1        TF0 = 0;    //清除TF0标志
  18   1        TR0 = 1;    //定时器0开始计时
  19   1        ET0=1;
  20   1        EA=1;
  21   1        PT0=0;
  22   1      }


