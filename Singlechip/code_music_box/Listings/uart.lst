   2          #include "uart.h"
   3          
   4          #define RELOAD_COUNT 0xFA //宏定义波特率发生器的载入值 9600
   5          
   6          void UART_Init(void)
   7          {
   8            SCON|=0X50;     //设置为工作方式1
   9            TMOD|=0X20;     //设置计数器工作方式2
  10            PCON=0X80;      //波特率加倍
  11            TH1=RELOAD_COUNT; //计数器初始值设置
  12            TL1=TH1;
  13            ES=0;       //关闭接收中断
  14            EA=1;       //打开总中断
  15            TR1=1;        //打开计数器
  16          //  TI=1;          //发送中断标记位，如果使用printf函数的必须设置 
  17          }
  18          
  19          void UART_SendData(u8 dat)
  20          {
  21            ES=0; //关闭串口中断
  22            TI=0; //清发送完毕中断请求标志位
  23            SBUF=dat; //发送
  24            while(TI==0); //等待发送完毕
  25            TI=0; //清发送完毕中断请求标志位
  26            ES=1; //允许串口中断
  27          }
  28          
  29          void UART_SendString(u8 *pbuf)
  30          {
  31            while(*pbuf!='\0') //遇到空格跳出循环 
  32            {
  33              UART_SendData(*pbuf);
  34              delay_10us(5);
  35              pbuf++; 
  36            }
  37          }
  38          
