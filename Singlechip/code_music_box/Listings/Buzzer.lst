line level    source

   1          #include "reg52.h"  
   2          #include "INTRINS.h"   // 包含内联汇编指令
   3          #include "public.h" 
   4          
   5          // 蜂鸣器端口
   6          sbit Buzzer = P2^5;   
   7          
   8          /*******************************************************************************
   9          * 函 数 名      : delay_msus
  10          * 函数功能       : 延时函数，单位是 10 微秒
  11          * 输    入       : x10us 延时的 10 微秒单位数
  12          * 输    出       : 无
  13          *******************************************************************************/
  14          
  15          void delay_msus(u16 x10us)  //@12.000MHz
  16          {
  17   1          while (x10us--)  
  18   1          {
  19   2              u8 i;
  20   2              _nop_();  // 空操作
  21   2              i = 2;
  22   2              while (--i); 
  23   2          }
  24   1      }
  25          
  26          /*******************************************************************************
  27          * 函 数 名      : Buzzer_Freq
  28          * 函数功能       : 蜂鸣器发声函数
  29          * 输    入       : Key，和相应的音调对应
  30          * 输    出       : 无
  31          *******************************************************************************/
  32          
  33          void Buzzer_Freq(u16 Key)
  34          {
  35   1          u16 i, N;
  36   1          u16 DesiredTime_ms = 100;   // 发音时间为100毫秒
  37   1      
  38   1          N = (DesiredTime_ms * 50) / Key;  // 计算需要反转的次数
  39   1      
  40   1          for (i = 0; i < N; i++)  
  41   1          {
  42   2              Buzzer = !Buzzer;  
  43   2              delay_msus(Key);   
  44   2          }
  45   1      }


