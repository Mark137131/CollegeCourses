  60          *******************************************************************************/
  61          void lcd9648_init(void)
  62          {
  63   1        RST=1;  
  64   1        delay_ms(10);
  65   1        RST=0;
  66   1        delay_ms(10);
  67   1        RST=1;
  68   1        delay_ms(10);//复位
  69   1      
  70   1        lcd9648_write_cmd(0xe2);      //软件复位
  71   1        lcd9648_write_cmd(0xc8);      //0xC8普通方向选择选择反向，0xC0为正常方向
  72   1        lcd9648_write_cmd(0xa0);      //0xA0段方向选择正常方向（0xA1为反方向
  73   1        lcd9648_write_cmd(0x2f);
  74   1        lcd9648_write_cmd(0x26);
  75   1        lcd9648_write_cmd(0x81);      //背景光对比度
  76   1        lcd9648_write_cmd(0x10);
  77   1        lcd9648_write_cmd(0xaf);      //开启显示
  78   1        lcd9648_write_cmd(0x40);      //设置滚动一行命令
  79   1      }
  80          
  81          /*******************************************************************************
