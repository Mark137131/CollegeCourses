 195          //显示16*16汉字
 196          //x,y:起点坐标 x:0-96 y:0-2
 197          //*cn:字符串起始地址      
 198          void lcd_show_16HZ(u8 x, u8 y, u8 *cn)
 199          {
 200   1        u8 j, x1, x2, wordNum;
 201   1        
 202   1        if(x>96||y>5)return;//超出范围了
 203   1      
 204   1        y *= 2;
 205   1        y += 0xB0;          //求取Y坐标的值
 206   1      
 207   1        while ( *cn != '\0')   //在C语言中字符串结束以‘\0’结尾
