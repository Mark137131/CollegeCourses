  86          *******************************************************************************/
  87          void lcd9648_clear(void)
  88          {
  89   1        u8 i,j;
  90   1      
  91   1        for(i=0;i<9;i++)//一共9页
  92   1        {
  93   2          lcd9648_write_cmd(0x40);//设置滚动一行命令
  94   2          lcd9648_write_cmd(0xb0+i);//页地址
  95   2          lcd9648_write_cmd(0x10);//列高字节地址
  96   2          lcd9648_write_cmd(0x00);//列低字节地址
  97   2          
  98   2          for(j = 0; j < LCD_WIDTH; j++)//每一行的像素点
  99   2          {
 100   3            lcd9648_write_dat(0x00);//不显示  
 101   3          } 
 102   2        }
 103   1      }
