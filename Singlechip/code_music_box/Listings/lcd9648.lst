 214   2          lcd9648_write_cmd(0x00+x2); //列低字节地址
 215   2      
 216   2          for (wordNum=0; wordNum<30; wordNum++)
 217   2          {
 218   3            //--查询要写的字在字库中的位置--//
 219   3            if ((CnChar16x16[wordNum].Index[0] == *cn)&&(CnChar16x16[wordNum].Index[1] == *(cn+1)))
 220   3            {
 221   4              for (j=0; j<32; j++) //写一个字
 222   4              {
 223   5                if (j == 16)   //由于16X16用到两个Y坐标，当大于等于16时，切换坐标
 224   5                {
 225   6                  lcd9648_write_cmd(y+1); //页地址 y坐标
 226   6                  lcd9648_write_cmd(0x10+x1); //列高字节地址 x坐标
 227   6                  lcd9648_write_cmd(0x00+x2); //列低字节地址
 228   6                }
 229   5                lcd9648_write_dat(CnChar16x16[wordNum].Msk[j]);
 230   5              }
 231   4              x += 16;
 232   4            }
 233   3          }
 234   2          cn += 2;  //下一个字
 235   2        }
