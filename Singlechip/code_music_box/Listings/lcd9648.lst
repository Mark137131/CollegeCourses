 158          //m^n函数
 159          //返回值:m^n次方.
 160          u32 lcd_pow(u8 m,u8 n)
 161          {
 162   1        u32 result=1;  
 163   1        while(n--)result*=m;    
 164   1        return result;
 165   1      } 
