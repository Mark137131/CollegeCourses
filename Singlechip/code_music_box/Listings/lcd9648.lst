   5          /*******************************************************************************
   6          * 函 数 名       : lcd9648_spi_write_byte
   7          * 函数功能     : LCD9648 SPI传输数据
   8          * 输    入       : dat：数据
   9          * 输    出       : 无
  10          *******************************************************************************/
  11          void lcd9648_spi_write_byte(u8 dat)
  12          {
  13   1        u8 i=0;
  14   1      
  15   1          for(i=0;i<8;i++)//循环8次将一个字节传输     
  16   1          {  
  17   2              if((dat&0x80)!=0) 
  18   2            SDA = 1;
  19   2              else 
  20   2            SDA = 0;
  21   2              dat<<= 1;//先写高位再写低位
  22   2            SCL = 0;
  23   2              SCL = 1;//时钟上升沿写入数据      
  24   2          }
  25   1      }
  26          
  27          /*******************************************************************************
  28          * 函 数 名       : lcd9648_write_cmd
  29          * 函数功能     : LCD9648写命令
  30          * 输    入       : cmd：命令
  31          * 输    出       : 无
  32          *******************************************************************************/
  33          void lcd9648_write_cmd(u8 cmd)
  34          {
  35   1        CS0 = 0;//使能
  36   1        RS  = 0;//选择命令
  37   1        lcd9648_spi_write_byte(cmd);//发送命令
  38   1        CS0 = 1;//失能  
  39   1      }
  40          
  41          /*******************************************************************************
  42          * 函 数 名       : lcd9648_write_dat
  43          * 函数功能     : LCD9648写数据
  44          * 输    入       : dat：数据
  45          * 输    出       : 无
  46          *******************************************************************************/
  47          void lcd9648_write_dat(u8 dat)
  48          {
  49   1        CS0 = 0;//使能
  50   1        RS  = 1;//选择数据
  51   1        lcd9648_spi_write_byte(dat);//发送数据
  52   1        CS0 = 1;//失能  
  53   1      }
